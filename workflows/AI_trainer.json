    {
      "parameters": {
        "jsCode": "let rawText = $input.item.json.output || \"\";\n\nfunction cleanText(value) {\n  if (typeof value !== \"string\") return value;\n  return value\n    .replace(/\\*\\*/g, \"\")\n    .replace(/\\*/g, \"\")\n    .trim();\n}\n\nfunction safeArray(value) {\n  if (Array.isArray(value)) return value.map(cleanText);\n  if (typeof value === \"string\") return [cleanText(value)];\n  return [];\n}\n\ntry {\n  const jsonPart = rawText.match(/\\{[\\s\\S]*\\}/);\n\n  if (jsonPart) {\n    const parsed = JSON.parse(jsonPart[0]);\n\n    const exerciseName = cleanText(parsed.exercise_name || parsed.name || \"תרגיל\");\n    const steps = safeArray(parsed.steps || parsed.instructions);\n    const safety = cleanText(parsed.safety || \"בצע את התרגיל בשליטה ועצור אם מופיע כאב.\");\n    const focus = cleanText(parsed.focus || parsed.muscles || \"לא צוין\");\n    const additionalNotes = cleanText(parsed.additional_notes || parsed.notes || \"שמור על טכניקה נכונה וקצב מבוקר.\");\n\n    let videoUrl = cleanText(parsed.video_url || \"\");\n\n    if (videoUrl) {\n      const videoIdMatch = videoUrl.match(/[?&]v=([^&#]+)/);\n      const videoId = videoIdMatch ? videoIdMatch[1] : null;\n\n      if (!videoId || videoId.length < 10) {\n        videoUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(exerciseName + \" demonstration\")}`;\n      }\n    } else {\n      videoUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(exerciseName + \" demonstration\")}`;\n    }\n\n    return {\n      exercise_name: exerciseName,\n      steps,\n      safety,\n      focus,\n      video_url: videoUrl,\n      additional_notes: additionalNotes,\n      is_exercise: true\n    };\n  }\n} catch (e) {}\n\nreturn {\n  output: cleanText(rawText),\n  is_exercise: false\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
