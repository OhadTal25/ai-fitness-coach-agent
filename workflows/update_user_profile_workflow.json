    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst clean = {};\n\nclean.user_id = input['user_id '];\n\nif (\n  input['injuries '] &&\n  input['injuries '] !== 'NO_INJURY_PROVIDED'\n) {\n  clean.injuries = input['injuries '];\n}\n\nif (\n  input['goal '] &&\n  input['goal '] !== 'EMPTY'\n) {\n  clean.goal = input['goal '];\n}\n\nif (\n  input['level '] &&\n  input['level '] !== 'EMPTY'\n) {\n  clean.level = input['level '];\n}\n\nif (\n  input['equipment '] &&\n  input['equipment '] !== 'EMPTY'\n) {\n  clean.equipment = input['equipment '];\n}\n\nif (\n  input['onboarding_step_ '] &&\n  input['onboarding_step_ '] !== 'EMPTY'\n) {\n  clean.onboarding_step = input['onboarding_step_ '];\n}\n\nif (\n  input['workouts_per_week '] !== undefined &&\n  input['workouts_per_week '] !== null\n) {\n  const n = Number(input['workouts_per_week ']);\n\n  if (!Number.isNaN(n) && n > 0) {\n    clean.workouts_per_week = n;\n  }\n}\n\nreturn [\n  {\n    json: clean\n  }\n];"
      },
