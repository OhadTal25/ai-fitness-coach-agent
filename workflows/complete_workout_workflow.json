      "name": "Get a row"
    },
    {
      "parameters": {
        "jsCode": "const user = $('Get a row').first().json;\n\nconst currentDay = Number(user.current_day_number || 1);\nconst daysPerWeek = Number(user.workouts_per_week || 3);\n\nlet nextDay = currentDay + 1;\n\nif (nextDay > daysPerWeek) {\n  nextDay = 1;\n}\n\nreturn [\n  {\n    json: {\n      user_id: user.telegram_user_id,\n      current_day_number: nextDay,\n      last_workout_date: new Date().toISOString().split('T')[0],\n      completed_day: currentDay\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "39336305-a9f4-4877-9f8f-a32334e15f43",
      "name": "Code in JavaScript"
    },
    {
