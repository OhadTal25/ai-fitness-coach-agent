    {
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst program = $('Create Program').first().json;\n\nlet days = input.program_days;\n\nfunction cleanProgramDays(raw) {\n  if (Array.isArray(raw)) {\n    return raw;\n  }\n\n  if (typeof raw !== 'string') {\n    throw new Error('program_days is not a string or array');\n  }\n\n  let text = raw.trim();\n\n  // Remove markdown code fences if the AI returned ```json ... ```\n  text = text\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/```$/i, '')\n    .trim();\n\n  try {\n    return JSON.parse(text);\n  } catch (error) {\n    // Fix common AI issue: real line breaks inside JSON strings\n    const fixed = text.replace(/\\r?\\n/g, '\\\\n');\n\n    try {\n      return JSON.parse(fixed);\n    } catch (secondError) {\n      throw new Error(\n        'program_days is not valid JSON. Original error: ' + error.message\n      );\n    }\n  }\n}\n\nconst parsedDays = cleanProgramDays(days);\n\nif (!Array.isArray(parsedDays)) {\n  throw new Error('program_days is not an array');\n}\n\nreturn parsedDays.map((day, index) => ({\n  json: {\n    program_id: program.id,\n    day_number: Number(day.day_number || index + 1),\n    week_number: Number(day.week_number || 1),\n    title: String(day.title || `יום ${index + 1}`),\n    description: String(day.description || '')\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
